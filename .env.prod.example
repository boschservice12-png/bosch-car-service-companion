# ============================================================================
#  Bosch Car Service Companion — PRODUCTION configuration (pilot)
#  Copy to `.env.prod` and fill in EVERY value marked <CHANGE-ME>.
#  Do NOT commit `.env.prod` (it is gitignored).
#
#  On the server this file is the ONLY copy of the generated credentials.
#  Keep it chmod 600.
#
#  Start:
#    docker compose --env-file .env.prod -f compose.prod.yaml up -d
# ============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
# A real, random secret. Readiness FAILS if it is empty or contains
# "change" / "dev-secret".
#   generate with:  openssl rand -hex 32
APP_SECRET=<CHANGE-ME-random-32-byte-hex>
APP_TIMEZONE=Europe/Bucharest

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=bcsc
POSTGRES_PASSWORD=<CHANGE-ME-strong-database-password>
POSTGRES_DB=bcsc
# Must match the values above (host = the `db` service name).
#
# Note the `serverVersion` and `charset` parameters: these are Doctrine
# parameters that libpq does not understand. The backup and restore scripts
# strip them before calling pg_dump/psql — see the pg_dsn() helper. Leave them
# here; Doctrine wants them.
DATABASE_URL="postgresql://bcsc:<CHANGE-ME-strong-database-password>@db:5432/bcsc?serverVersion=16&charset=utf8"

# --- Queues / cache (Messenger on Doctrine; Redis available) ---------------
# auto_setup=0 because migrations own the schema (Version20260715234015 creates
# `messenger_messages`), not Messenger. Start-up ordering is guaranteed
# separately by the one-shot `migrate` service in compose.prod.yaml, which both
# `backend` and `worker` depend on — so this is defence in depth, not the only
# safety net.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
REDIS_URL=redis://redis:6379

# --- Document storage (S3/MinIO) -------------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bcsc-documents
# For MinIO, S3_KEY/S3_SECRET = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (same values).
S3_KEY=<CHANGE-ME-same-as-MINIO_ROOT_USER>
S3_SECRET=<CHANGE-ME-same-as-MINIO_ROOT_PASSWORD>
S3_REGION=us-east-1
MINIO_ROOT_USER=<CHANGE-ME-same-as-S3_KEY>
MINIO_ROOT_PASSWORD=<CHANGE-ME-same-as-S3_SECRET>

# --- Antimalware (ClamAV — active when APP_ENV=prod) -----------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Public origins / TLS --------------------------------------------------
# WITH DOMAINS (recommended): set the hostnames → Caddy handles TLS
# automatically via Let's Encrypt.
#   CUSTOMER_SITE=app.bcss.ro
#   ADMIN_SITE=admin.app.bcss.ro
# WITHOUT A DOMAIN (IP only, to begin with): leave the defaults (plain HTTP),
# and re-add the 8081 port mapping in compose.prod.yaml.
CUSTOMER_SITE=:80
ADMIN_SITE=:8081

# CORS is not strictly required (Next proxies /api same-origin), but set the
# public origins for CSRF (double-submit) when using domains.
CORS_ALLOW_ORIGIN="https://app.bcss.ro,https://admin.app.bcss.ro"
CSRF_TRUSTED_ORIGINS="https://app.bcss.ro,https://admin.app.bcss.ro"

# --- Off-box backup (Lightsail object storage / any S3-compatible target) --
# A backup on the disk it protects is NOT a backup: if the instance is lost, the
# `backups` volume goes with it. Set this before real users. Left empty, the
# backup still runs but stays local only, and logs an explicit warning on every
# run.
#
# Lightsail object storage: create the bucket in the same region
# (eu-central-1), enable object versioning, generate an access key in the
# console, and use the plain regional endpoint below — NOT the bucket-qualified
# hostname the console displays.
OFFSITE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
OFFSITE_BUCKET=
OFFSITE_KEY=
OFFSITE_SECRET=
OFFSITE_PREFIX=bcss
# Bucket lookup style: `auto` usually works. If `mc` reports "bucket not found"
# even though the bucket exists, force `dns` (virtual-host — AWS S3 and
# Lightsail object storage) or `path` (MinIO).
OFFSITE_LOOKUP=auto
# Off-box retention is longer than local (BACKUP_KEEP_DAYS=14).
OFFSITE_KEEP_DAYS=30

# --- GDPR retention --------------------------------------------------------
# `app:gdpr:purge` runs daily from the `scheduler` service at the hour below
# (UTC), AFTER the backup (hour 3) — save first, then delete irreversibly.
GDPR_PURGE_HOUR=4
GDPR_PURGE_ENABLED=1

# --- Legacy plate-only account claiming stays DISABLED ---------------------
# See docs/architecture/ and the security notes: claiming an account with only a
# registration plate is not acceptable authentication. Do not enable in
# production.
LEGACY_PLATE_CLAIM_ENABLED=false
