# ============================================================================
#  Bosch Car Service Companion — configurație de PRODUCȚIE (pilot)
#  Copiați în `.env.prod` și completați TOATE valorile marcate <SCHIMBAȚI>.
#  NU comiteți `.env.prod` în git (e în .gitignore).
#
#  Pornire:
#    docker compose --env-file .env.prod -f compose.prod.yaml up -d --build
# ============================================================================

# --- Aplicație -------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
# Secret real, aleator. Readiness PICĂ dacă e gol sau conține „change"/„dev-secret".
#   generați:  openssl rand -hex 32
APP_SECRET=<SCHIMBAȚI-secret-aleator-32-bytes-hex>
APP_TIMEZONE=Europe/Bucharest

# --- Bază de date (PostgreSQL) --------------------------------------------
POSTGRES_USER=bcsc
POSTGRES_PASSWORD=<SCHIMBAȚI-parolă-db-puternică>
POSTGRES_DB=bcsc
# Trebuie să corespundă valorilor de mai sus (host = numele serviciului `db`).
DATABASE_URL="postgresql://bcsc:<SCHIMBAȚI-parolă-db-puternică>@db:5432/bcsc?serverVersion=16&charset=utf8"

# --- Cozi / cache (Messenger pe Doctrine; Redis disponibil) ---------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
REDIS_URL=redis://redis:6379

# --- Storage documente (S3/MinIO) -----------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bcsc-documents
# Pentru MinIO, S3_KEY/S3_SECRET = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (aceleași valori).
S3_KEY=<SCHIMBAȚI-egal-cu-MINIO_ROOT_USER>
S3_SECRET=<SCHIMBAȚI-egal-cu-MINIO_ROOT_PASSWORD>
S3_REGION=us-east-1
MINIO_ROOT_USER=<SCHIMBAȚI-egal-cu-S3_KEY>
MINIO_ROOT_PASSWORD=<SCHIMBAȚI-egal-cu-S3_SECRET>

# --- Antimalware (ClamAv — activ în APP_ENV=prod) -------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Origini publice / TLS -------------------------------------------------
# CU DOMENIU (recomandat): puneți hostname-urile → Caddy face TLS automat (Let's Encrypt).
#   CUSTOMER_SITE=companion.exemplu.ro
#   ADMIN_SITE=admin.companion.exemplu.ro
# FĂRĂ DOMENIU (doar IP, la început): lăsați valorile implicite (HTTP simplu).
CUSTOMER_SITE=:80
ADMIN_SITE=:8081

# CORS nu e necesar (apelurile /api sunt proxy-ate same-origin de Next), dar
# setați originile publice pentru CSRF (double-submit) când folosiți domenii.
CORS_ALLOW_ORIGIN="https://companion.exemplu.ro,https://admin.companion.exemplu.ro"
CSRF_TRUSTED_ORIGINS="https://companion.exemplu.ro,https://admin.companion.exemplu.ro"

# --- Blocul 3: revendicarea legacy prin număr rămâne DEZACTIVATĂ ----------
LEGACY_PLATE_CLAIM_ENABLED=false
