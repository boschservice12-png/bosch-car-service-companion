# Valori implicite (dev), pentru rulare în docker-compose.
# Secretele reale și suprascrierile locale merg în `.env.local` (negitat).
# NOTĂ: în dotenv, ULTIMA definiție a unei variabile câștigă — nu duplica cheile.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=dev-secret-change-in-local-and-prod
###< symfony/framework-bundle ###

APP_TIMEZONE=Europe/Bucharest

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Host `postgres` = numele serviciului din docker-compose.
DATABASE_URL="postgresql://bcsc:bcsc@postgres:5432/bcsc?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Transport implicit: Doctrine (PostgreSQL) — durabil, tranzacțional, fără
# dependențe suplimentare de extensii. Redis rămâne pentru rate limiting/cache.
# Pentru cozi pe Redis: instalează symfony/redis-messenger și setează
# MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

REDIS_URL=redis://redis:6379
CORS_ALLOW_ORIGIN="http://localhost:3000,http://localhost:3001"

# Object storage (S3-compatible / MinIO) + scanare antimalware (prod)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bcsc-documents
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CSRF_TRUSTED_ORIGINS=
